# FinSta Backend Configuration
# LLM Provider switchable: "gemini" or "anthropic" (or local fallback mock if keys are unset)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# API Keys (Provide the relevant key based on LLM_PROVIDER)
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

APP_ENV=development
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=20
DATABASE_URL=sqlite:///./finsta.db
